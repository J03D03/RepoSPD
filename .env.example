# Example environment configuration for RepoSPD docker-compose pipeline.
# Copy this file to .env and adjust the values as needed.

# Host user ID and group ID for permissions inside the container.
# Find your UID and GID by running `id -u` and `id -g` on your host.
UID=1000
GID=1000

# CPU limit for container execution (e.g., 0.6 for 60% of a single CPU core, or higher for more cores).
# For multi-core machines, a limit like "8.0" allows 8 cores. 
CPU_LIMIT=0.6

# CPU set (comma-separated list or hyphen-separated range of CPUs a container can use).
# Leave empty to allow the scheduler to pick any available cores.
CPUSET=
